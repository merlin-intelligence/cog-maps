# Copy to .env (or .streamlit/secrets.toml) and fill in real values.
# .env is git-ignored.

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Required by docker-compose.yml (QDRANT__SERVICE__API_KEY) — generate with
# `openssl rand -hex 32`. Must match on both the Qdrant container and the app.
QDRANT_API_KEY=

# The /ask/ LLM backend (Nebius cloud ⇄ local Ollama) is chosen from the sidebar
# toggle and defaults to Nebius. Optional overrides (see the install guide):
#   LLM_PROVIDER=ollama          # change the default selection at startup
#   OLLAMA_HOST=http://host:11434 / OLLAMA_MODELS=...   # non-standard Ollama setup

# Nebius / AI Hub (required for the Nebius backend)
NEBIUS_API_KEY=

# HuggingFace token (only needed for gated local LLMs in eigenmind.core.llm)
HF_TOKEN=

# SharePoint (optional)
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Tesseract data path (optional, enables OCR on scanned PDFs)
TESSDATA_PREFIX=

# Cap on distinct documents loaded by the /analyze corpus/ page (default: 3000).
# Above this, a random sample is analyzed instead to keep memory usage bounded
# on the shared Streamlit process. Raise it if you need to analyze a larger
# corpus in one go and have the RAM to spare.
MAX_ANALYSIS_DOCUMENTS=
