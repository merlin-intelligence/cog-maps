# Copy to .env (or .streamlit/secrets.toml) and fill in real values.
# .env is git-ignored.

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
# Required by docker-compose.yml (QDRANT__SERVICE__API_KEY) — generate with
# `openssl rand -hex 32`. Must match on both the Qdrant container and the app.
QDRANT_API_KEY=

# Oxigraph (RDF triplestore backing /build ontology/) — started alongside
# Qdrant by docker-compose.yml, no auth of its own.
OXIGRAPH_URL=http://localhost:7878

# The /ask/ LLM backend (Scaleway cloud ⇄ local Ollama) is chosen from the sidebar
# toggle and defaults to Scaleway. Optional overrides (see the install guide):
#   LLM_PROVIDER=ollama          # change the default selection at startup
#   OLLAMA_HOST=http://host:11434 / OLLAMA_MODELS=...   # non-standard Ollama setup

# Scaleway Generative APIs (required for the Scaleway backend)
SCALEWAY_API_KEY=

# Where the ontology builds' OLAF subprocess caches its embedding model
# (ONNX, ~1.1 GB). Defaults to ~/.cache/fastembed.
#   FASTEMBED_CACHE_PATH=/path/to/cache

# Domain discovery on /build ontology/ (optional overrides, see the install guide):
#   DOMAIN_DISCOVERY_MODEL=qwen3.8-27b          # Scaleway model that synthesizes the blueprint
#   DOMAIN_PROFILES_DIR=user_data/ontology/domain_profiles  # where blueprints are cached (one JSON per collection)

# HuggingFace token (only needed for gated local LLMs in eigenmind.core.llm)
HF_TOKEN=

# SharePoint (optional)
SHAREPOINT_CLIENT_ID=
SHAREPOINT_CLIENT_SECRET=

# Tesseract data path (optional, enables OCR on scanned PDFs)
TESSDATA_PREFIX=

# Cap on distinct documents loaded by the /analyze corpus/ page (default: 3000).
# Above this, a random sample is analyzed instead to keep memory usage bounded
# on the shared Streamlit process. Raise it if you need to analyze a larger
# corpus in one go and have the RAM to spare.
MAX_ANALYSIS_DOCUMENTS=

# Token budget for one /ask/ answer with the Scaleway backend (default: 8192).
# Reasoning models count their thinking against it — raise it if answers
# come back truncated.
CHAT_MAX_TOKENS=

# Langfuse LLM tracing (optional — enabled when both keys are set).
# Keys come from the project's settings page in the Langfuse UI.
# LANGFUSE_HOST: https://cloud.langfuse.com (EU), https://us.cloud.langfuse.com (US),
# or your self-hosted URL. Unset defaults to the US cloud.
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
